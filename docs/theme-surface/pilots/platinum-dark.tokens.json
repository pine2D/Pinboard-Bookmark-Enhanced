{
  "meta": {
    "id": "platinum-dark",
    "name": "Platinum Dark",
    "mode": "dark",
    "family": "platinum",
    "description": "Mac OS 9 Platinum dark desktop window chrome (hub.v2core.com dark scheme)."
  },
  "layout": {
    "mode": "classic-list",
    "max-width": "1030px",
    "bookmark-style": "flat",
    "right-bar": "visible"
  },
  "palette": {
    "bg": "#222222",
    "bg-surface": "#2c2c2c",
    "fg": "#eeeeee",
    "fg-strong": "#f5f5f5",
    "muted": "#c2c2c2",
    "muted-soft": "#b0b0b0",
    "metadata-fg": "#b0b0b0",
    "border": "#888888",
    "border-strong": "#b0b0b0",
    "border-soft": "#444444",
    "accent": "#8ec0ff",
    "accent-hover": "#b8d8ff",
    "accent-soft": "#383838",
    "accent-alpha": "rgba(142,192,255,0.32)",
    "input-bg": "#3b3b3b",
    "private-bg": "#262626",
    "private-accent": "#8ec0ff",
    "selection-bg": "#383838",
    "selection-fg": "#ffffff",
    "tag-bg": "#3b3b3b",
    "tag-fg": "#eeeeee",
    "row-hover": "#343434",
    "bundle-row-hover": "#ffffff14",
    "destroy": "#ff8a80",
    "btn-bg": "#3b3b3b",
    "btn-bg-hover": "#474747",
    "btn-fg": "#ffffff",
    "success": "#65d48a",
    "success-hover": "#8ae3a8",
    "url-link-bg": "#2a2a2a",
    "url-link-fg": "#d0d0d0",
    "link-hover": "#b8d8ff",
    "link-visited": "#d4d4d4",
    "focus-ring": "#8ec0ff",
    "unread": "#ff8a80",
    "sidebar-btn-bg": "#3b3b3b",
    "sidebar-btn-fg": "#ffffff",
    "sidebar-btn-bg-hover": "#474747"
  },
  "typo": {
    "family": "\"Lucida Grande\", \"Geneva\", Verdana, sans-serif",
    "family-mono": "\"SFMono-Regular\", Menlo, Monaco, Consolas, monospace",
    "size-base": "13px",
    "size-lg": "14px",
    "size-sm": "12px",
    "size-xs": "11px",
    "line-height": 1.5,
    "weight-body": 400,
    "weight-heading": 700
  },
  "space": {
    "unit": "4px",
    "bookmark-gap": "0px",
    "main-padding": "0px",
    "sub-banner-y": "6px",
    "right-bar-gap": "12px",
    "form-gap": "8px"
  },
  "radius": {
    "sm": "2px",
    "md": "3px",
    "lg": "3px"
  },
  "border": {
    "width": "1px",
    "style": "solid",
    "hairline": "1px solid #333333"
  },
  "patterns": {
    "window-chrome": "platinum",
    "blockquote-style": "left-accent",
    "heading-accent": "caps"
  },
  "ui": {
    "density": "compact",
    "popup": {
      "dark": {
        "link": "#8ec0ff",
        "on-accent": "#101828",
        "radius-sm": "2px",
        "radius-md": "3px",
        "radius-lg": "3px",
        "radius-tag": "2px"
      }
    },
    "options": {
      "dark": {
        "warn": "#e5b045",
        "danger": "#e05550",
        "radius-sm": "2px",
        "radius-md": "3px",
        "radius-lg": "3px"
      }
    },
    "library": {
      "dark": {
        "radius-sm": "2px",
        "radius-md": "3px",
        "radius-lg": "3px"
      }
    }
  }
}
