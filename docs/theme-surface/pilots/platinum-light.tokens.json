{
  "meta": {
    "id": "platinum-light",
    "name": "Platinum Light",
    "mode": "light",
    "family": "platinum",
    "description": "Mac OS 9 Platinum light desktop window chrome (stats.v2core.com / Apple HIG)."
  },
  "layout": {
    "mode": "classic-list",
    "max-width": "1030px",
    "bookmark-style": "flat",
    "right-bar": "visible"
  },
  "palette": {
    "bg": "#dddddd",
    "bg-surface": "#ffffff",
    "fg": "#222222",
    "fg-strong": "#111111",
    "muted": "#4d4d4d",
    "muted-soft": "#545454",
    "metadata-fg": "#545454",
    "border": "#767676",
    "border-strong": "#262626",
    "border-soft": "#b8b8b8",
    "accent": "#1d4496",
    "accent-hover": "#14316e",
    "accent-soft": "#e6e6e6",
    "accent-alpha": "rgba(29,68,150,0.28)",
    "input-bg": "#cccccc",
    "private-bg": "#f4f4f4",
    "private-accent": "#1d4496",
    "selection-bg": "#b8b8b8",
    "selection-fg": "#111111",
    "tag-bg": "#e4e4e4",
    "tag-fg": "#222222",
    "row-hover": "#efefef",
    "bundle-row-hover": "#26262612",
    "destroy": "#7a1010",
    "btn-bg": "#333333",
    "btn-bg-hover": "#222222",
    "btn-fg": "#ffffff",
    "success": "#1f6b35",
    "success-hover": "#144d25",
    "url-link-bg": "#eeeeee",
    "url-link-fg": "#444444",
    "link-hover": "#14316e",
    "link-visited": "#3b3b3b",
    "focus-ring": "#1d4496",
    "unread": "#7a1010",
    "sidebar-btn-bg": "#333333",
    "sidebar-btn-fg": "#ffffff",
    "sidebar-btn-bg-hover": "#222222"
  },
  "typo": {
    "family": "\"Lucida Grande\", \"Geneva\", Verdana, sans-serif",
    "family-mono": "\"SFMono-Regular\", Menlo, Monaco, Consolas, monospace",
    "size-base": "13px",
    "size-lg": "14px",
    "size-sm": "12px",
    "size-xs": "11px",
    "line-height": 1.5,
    "weight-body": 400,
    "weight-heading": 700
  },
  "space": {
    "unit": "4px",
    "bookmark-gap": "0px",
    "main-padding": "0px",
    "sub-banner-y": "6px",
    "right-bar-gap": "12px",
    "form-gap": "8px"
  },
  "radius": {
    "sm": "2px",
    "md": "3px",
    "lg": "3px"
  },
  "border": {
    "width": "1px",
    "style": "solid",
    "hairline": "1px solid #d4d4d4"
  },
  "patterns": {
    "window-chrome": "platinum",
    "blockquote-style": "left-accent",
    "heading-accent": "caps"
  },
  "ui": {
    "density": "compact",
    "popup": {
      "light": {
        "on-accent": "#ffffff",
        "radius-sm": "2px",
        "radius-md": "3px",
        "radius-lg": "3px",
        "radius-tag": "2px"
      }
    },
    "options": {
      "light": {
        "warn": "#7a5200",
        "danger": "#a02525",
        "radius-sm": "2px",
        "radius-md": "3px",
        "radius-lg": "3px"
      }
    },
    "library": {
      "light": {
        "radius-sm": "2px",
        "radius-md": "3px",
        "radius-lg": "3px"
      }
    }
  }
}
